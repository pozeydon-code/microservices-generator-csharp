        var missing = await handler.Handle(new Update{{ .Entity.Name }}Command { Id = Guid.NewGuid(), {{ range .Entity.NonIDFields }}{{ .Name }} = {{ .SampleValue }}, {{ end }} ConcurrencyToken = "token-v1" }, CancellationToken.None);
        var conflict = await handler.Handle(new Update{{ .Entity.Name }}Command { Id = entity.Id, {{ range .Entity.NonIDFields }}{{ .Name }} = {{ .UpdatedValue }}, {{ end }} ConcurrencyToken = "stale-token" }, CancellationToken.None);
