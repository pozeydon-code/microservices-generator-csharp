    private sealed class Fake{{ .Entity.Name }}Repository : I{{ .Entity.Name }}Repository
    {
        public List<Domain{{ .Entity.Name }}> Items { get; } = [];
        public int AddCalls { get; private set; }
        private string CurrentToken { get; set; } = "token-v1";

        public Task<(IReadOnlyList<EntitySnapshot<Domain{{ .Entity.Name }}>> Items, int TotalCount)> ListAsync(int skip, int take, CancellationToken cancellationToken) =>
            Task.FromResult(((IReadOnlyList<EntitySnapshot<Domain{{ .Entity.Name }}>>)Items.Skip(skip).Take(take).Select(ToSnapshot).ToList(), Items.Count));

        public Task<EntitySnapshot<Domain{{ .Entity.Name }}>?> GetByIdAsync(Guid id, CancellationToken cancellationToken) =>
            Task.FromResult(Items.SingleOrDefault(item => item.Id == id) is { } entity ? ToSnapshot(entity) : null);

        public Task<EntitySnapshot<Domain{{ .Entity.Name }}>> AddAsync(Domain{{ .Entity.Name }} entity, CancellationToken cancellationToken)
        {
            AddCalls++;
            Items.Add(entity);
            return Task.FromResult(ToSnapshot(entity));
        }

        public Task<SaveResultStatus> UpdateAsync(Domain{{ .Entity.Name }} entity, string concurrencyToken, CancellationToken cancellationToken)
        {
            if (concurrencyToken == "stale-token") return Task.FromResult(SaveResultStatus.Conflict);
            if (concurrencyToken != CurrentToken) return Task.FromResult(SaveResultStatus.InvalidToken);
            CurrentToken = "token-v2";
            return Task.FromResult(SaveResultStatus.Saved);
        }

        public Task<SaveResultStatus> DeleteAsync(Domain{{ .Entity.Name }} entity, string concurrencyToken, CancellationToken cancellationToken)
        {
            if (concurrencyToken == "stale-token") return Task.FromResult(SaveResultStatus.Conflict);
            if (concurrencyToken != CurrentToken) return Task.FromResult(SaveResultStatus.InvalidToken);
            Items.Remove(entity);
            return Task.FromResult(SaveResultStatus.Saved);
        }

        private EntitySnapshot<Domain{{ .Entity.Name }}> ToSnapshot(Domain{{ .Entity.Name }} entity) => new(entity, CurrentToken);
    }
