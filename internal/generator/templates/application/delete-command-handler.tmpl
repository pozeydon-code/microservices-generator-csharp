using ErrorOr;
using MediatR;
using {{ .Service.Name }}.Application.Common;
using {{ .Service.Name }}.Application.{{ .Entity.FeatureName }}.Interfaces;
using {{ .Service.Name }}.Domain.Entities;

namespace {{ .Service.Name }}.Application.{{ .Entity.FeatureName }}.Commands.Delete;

public sealed class Delete{{ .Entity.Name }}CommandHandler(I{{ .Entity.Name }}Repository repository, IUnitOfWork unitOfWork) : IRequestHandler<Delete{{ .Entity.Name }}Command, ErrorOr<Deleted>>
{
    public async Task<ErrorOr<Deleted>> Handle(Delete{{ .Entity.Name }}Command request, CancellationToken cancellationToken)
    {
        var snapshot = await repository.GetByIdAsync(request.Id, cancellationToken);
        if (snapshot is null)
        {
            return Error.NotFound(code: "{{ .Entity.Name }}.NotFound", description: "{{ .Entity.Name }} was not found.");
        }
        if (string.IsNullOrWhiteSpace(request.ConcurrencyToken))
        {
            return Error.Validation(code: "ConcurrencyToken.Required", description: "Concurrency token is required.", metadata: new Dictionary<string, object> { ["field"] = "concurrencyToken" });
        }

        var status = await repository.DeleteAsync(snapshot.Entity, request.ConcurrencyToken, cancellationToken);
        if (status == SaveResultStatus.Conflict)
        {
            return Error.Conflict(code: "{{ .Entity.Name }}.ConcurrencyConflict", description: "{{ .Entity.Name }} was changed by another request.");
        }
        if (status == SaveResultStatus.InvalidToken)
        {
            return Error.Validation(code: "ConcurrencyToken.Invalid", description: "Invalid concurrency token.", metadata: new Dictionary<string, object> { ["field"] = "concurrencyToken" });
        }

        try
        {
            await unitOfWork.SaveChangesAsync(cancellationToken);
        }
        catch (ConcurrencyConflictException)
        {
            return Error.Conflict(code: "{{ .Entity.Name }}.ConcurrencyConflict", description: "{{ .Entity.Name }} was changed by another request.");
        }

        return Result.Deleted;
    }
}
