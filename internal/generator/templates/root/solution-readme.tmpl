```bash
dotnet ef migrations add InitialCreate --project ./{{ .Name }}/src/{{ .Name }}.Infrastructure --startup-project ./{{ .Name }}/src/{{ .Name }}.Infrastructure --output-dir Persistence/Migrations
dotnet ef database update --project ./{{ .Name }}/src/{{ .Name }}.Infrastructure --startup-project ./{{ .Name }}/src/{{ .Name }}.Infrastructure
```

