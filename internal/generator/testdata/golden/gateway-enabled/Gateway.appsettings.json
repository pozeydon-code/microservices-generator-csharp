{
  "ReverseProxy": {
    "Routes": {      "product-service-route": {
        "ClusterId": "product-service-cluster",
        "Match": {
          "Path": "/product-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/product-service"
          }
        ]
      }
    },
    "Clusters": {      "product-service-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5100/"
          }
        }
      }
    }
  }
}
